<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header with IDM Branding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Download File Info"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIdmPaste"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📋 Paste"
            android:textColor="@color/primary_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- URL Input Field -->
    <EditText
        android:id="@+id/etIdmUrl"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Enter or paste download URL..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:background="@drawable/bg_button_dark"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <!-- Metadata Probing Indicator -->
    <LinearLayout
        android:id="@+id/layoutIdmProbing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_button_dark"
        android:padding="10dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbIdmProbing"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvIdmProbingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contacting server &amp; probing metadata..."
            android:textColor="@color/primary_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Metadata Details Container -->
    <LinearLayout
        android:id="@+id/layoutIdmMetadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Detected File Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Name"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etIdmFilename"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Filename (auto-probed from server)"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:layout_marginBottom="10dp" />

        <!-- Badges: Size, Resumable, Content-Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvIdmSizeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size: Unknown"
                android:textColor="@color/primary_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvIdmResumeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Resumable"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvIdmTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type: Stream"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Category & Folder Path -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spIdmCategory"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIdmSavePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Folder: /DL_Engine"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnIdmCancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnIdmQueueLater"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Queue Later"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnIdmStartNow"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Start Download"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

</LinearLayout>
