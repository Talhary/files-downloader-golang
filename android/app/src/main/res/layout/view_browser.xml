<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top URL & Navigation Bar -->
    <LinearLayout
        android:id="@+id/browserNavBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface_card">

        <Button
            android:id="@+id/btnBrowserBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="◀"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBrowserForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="▶"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/etBrowserUrl"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:hint="Search or enter URL..."
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnBrowserGo"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="GO"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Browser Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbBrowserLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/browserNavBar"
        android:visibility="gone"
        android:progressDrawable="@drawable/progress_horizontal_cyan" />

    <!-- Embedded Chromium WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pbBrowserLoading" />

    <!-- Floating Media Sniffer Detection Pill -->
    <LinearLayout
        android:id="@+id/snifferPill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_cyan"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvSnifferText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥 Downloadable Media Detected (1)"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
