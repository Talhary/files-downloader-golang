<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <!-- Top Row: File Name & Category Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDoneFilename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="completed_file.mp4"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvDoneCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Details Row: Size and Date -->
    <TextView
        android:id="@+id/tvDoneDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1.25 GB • Completed 2026-09-23"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp" />

    <!-- Action Buttons Row: Open, Share, Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDoneOpen"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:text="Open"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDoneShare"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:text="Share"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:background="@drawable/bg_button_dark"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDoneDelete"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:text="Delete"
            android:textColor="@color/accent_rose"
            android:textSize="11sp"
            android:background="@drawable/bg_button_dark" />

    </LinearLayout>

</LinearLayout>
