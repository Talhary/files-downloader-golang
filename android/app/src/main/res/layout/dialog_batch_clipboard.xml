<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvBatchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 Batch Import from Clipboard"
        android:textColor="@color/primary_cyan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvBatchCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Found 0 links ready to download"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Links Preview:"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_button_dark"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvBatchPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://..."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnBatchCancel"
            android:layout_width="80dp"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnBatchAddAll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Add All to Queue"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
