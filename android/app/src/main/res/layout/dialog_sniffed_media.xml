<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSniffedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📥 Downloadable Media Detected"
        android:textColor="@color/primary_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvSniffedUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="https://example.com/video.mp4"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The detected media stream will be downloaded as advertised."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnSniffedCancel"
            android:layout_width="80dp"
            android:layout_height="38dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@drawable/bg_button_dark"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSniffedDownload"
            android:layout_width="120dp"
            android:layout_height="38dp"
            android:text="Start Download"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan" />
    </LinearLayout>

</LinearLayout>
